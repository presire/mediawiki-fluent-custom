{
	"name": "Fluent",
	"version": "0.8.0",
	"author": [
		"[https://github.com/presire presire] (Fluent Custom)",
		"[https://github.com/immewnity immewnity] (original Fluent skin)"
	],
	"url": "https://github.com/presire/mediawiki-fluent-custom",
	"descriptionmsg": "fluent-desc",
	"namemsg": "fluent",
	"license-name": "MIT",
	"type": "skin",
	"ConfigRegistry": {
		"Fluent": "GlobalVarConfig::newInstance"
	},
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"ValidSkinNames": {
		"fluent": {
			"displayname": "Fluent",
			"class": "MediaWiki\\Skin\\Fluent\\SkinFluent",
			"args": [
				{
					"name": "fluent",
					"template": "MediaWiki\\Skin\\Fluent\\FluentTemplate",
					"responsive": true,
					"clientPrefEnabled": true
				}
			]
		}
	},
	"SkinLessImportPaths": {
		"fluent": "resources/mediawiki.less"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Skin\\Fluent\\Hooks"
		}
	},
	"Hooks": {
		"GetPreferences": "main"
	},
	"DefaultUserOptions": {
		"fluent-theme": "os"
	},
	"MessagesDirs": {
		"Fluent": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.fluent": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": [
				"normalize",
				"elements",
				"content",
				"interface",
				"logo"
			],
			"styles": {
				"resources/fabric.min.css": {
					"media": "screen"
				},
				"resources/screen-common.less": {
					"media": "screen"
				},
				"resources/screen-desktop.less": {
					"media": "screen and (min-width: 751px)"
				},
				"resources/screen-mobile.less": {
					"media": "screen and (max-width: 750px)"
				},
				"resources/print.css": {
					"media": "print"
				}
			}
		},
		"skins.fluent.js": {
			"scripts": [
				"resources/main.js"
			],
			"dependencies": [
				"jquery",
				"mediawiki.base",
				"mediawiki.util",
				"mediawiki.user",
				"mediawiki.api"
			],
			"messages": [
				"fluent-image-close",
				"fluent-image-reset",
				"fluent-image-open-file",
				"fluent-image-dialog-label",
				"fluent-toc-reset"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Fluent"
	},
	"ResourceModuleSkinStyles": {
		"fluent": {
			"+ext.echo.styles.badge": "resources/extensions/echo.styles.badge.less",
			"+ext.visualEditor.base": "resources/extensions/ext.visualEditor.less",
			"+ext.popups.main": "resources/extensions/ext.popups.main.less",
			"+ext.discussionTools.init.styles": "resources/extensions/ext.discussionTools.init.styles.less",
			"+ext.uls.pt": "resources/extensions/ext.uls.pt.less",
			"+ext.CodeMirror.v6.WikiEditor": "resources/extensions/ext.CodeMirror.v6.WikiEditor.less",
			"+ext.CodeMirror.WikiEditor": "resources/extensions/ext.CodeMirror.WikiEditor.less"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skin\\Fluent\\": "includes/"
	},
	"config": {
		"FluentDisableGravatar": {
			"value": false,
			"help": "Control whether or not we should use Gravatar. You should set this to true for wikis not available over the internet"
		}
	},
	"manifest_version": 2
}
